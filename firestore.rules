rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Função auxiliar para garantir que apenas o usuário autenticado acesse seus próprios dados
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /usuarios/{userId} {
      // Usuário só pode ler seu próprio documento de perfil
      allow get: if isOwner(userId);
      allow list: if false;

      // Usuário pode criar e atualizar seus próprios dados (XP, nível, ofensiva, última leitura)
      // Permite exclusão pelo próprio usuário (Módulo 5 - Direito ao Esquecimento / LGPD)
      allow create, update, delete: if isOwner(userId);

      // Subcoleção de Estante de Livros
      match /estante/{itemId} {
        allow read, write: if isOwner(userId);
      }

      // Subcoleção de Sessões de Leitura (Histórico)
      // Imutável para edição (update false), permitindo exclusão apenas na limpeza de conta
      match /sessoes/{sessaoId} {
        allow read, create, delete: if isOwner(userId);
        allow update: if false;
      }

      // Subcoleção de Conquistas (Módulo 4)
      match /conquistas/{conquistaId} {
        allow read, write: if isOwner(userId);
      }

      // Subcoleção de Metas de Leitura (Módulo 4)
      match /metas/{metaId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Coleção Pública de Ranking (Módulo 5 - Social & Leaderboard)
    match /ranking/{userId} {
      // Qualquer usuário autenticado pode consultar o ranking dos leitores
      allow read: if request.auth != null;
      // O leitor só pode atualizar ou remover seu próprio registro de ranking
      allow create, update, delete: if isOwner(userId);
    }
  }
}
